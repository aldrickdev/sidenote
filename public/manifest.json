{
  "manifest_version": 3,
  "name": "Sidenote — bookmarks with context",
  "version": "0.1.0",
  "description": "Save the link. Keep the context. A private bookmark library in your side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open Sidenote", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
